---
import smartphone from "../images/icons/smartphone.svg";
import location from "../images/icons/location.svg";
import email from "../images/icons/email.svg";
import bg_contact from "../images/bg_contact.webp";
---

<section
  id="contact"
  class="relative w-full flex flex-col items-center justify-center py-10 bg-pink-100">
  <img
    src={bg_contact.src}
    alt=""
    class="absolute h-full w-full object-cover opacity-10 z-0"
  />
  <div
    class="relative w-full md:w-3/5 flex flex-col items-center justify-center">
    <h1
      data-aos="fade-down"
      data-aos-anchor-placement="center-bottom"
      class="text-3xl text-pink-500 font-semibold">
      Where to Find Me?
    </h1>
    <div
      class="flex flex-col md:flex-row-reverse py-10 justify-between gap-4 w-full">
      <iframe
        title="googlemaps iframe"
        data-aos="fade-left"
        data-aos-anchor-placement="center-bottom"
        class="rounded-xl shadow-lg shadow-gray-500 w-screen md:w-full px-2"
        src="https://maps.google.com/maps?q=220%20Miracle%20Mile%2C%20Coral%20Gables%2C%20FL%2033134&z=15&output=embed"
        width="600"
        height="450"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
      <div
        data-aos="fade-right"
        data-aos-anchor-placement="center-bottom"
        class="flex flex-col items-center justify-center space-y-3 text-gray-500 font-semibold p-10">
        <h1 class="text-2xl text-pink-500 py-2">Contact Info</h1>
        <div class="flex flex-col gap-1">
          <a href="mailto:hello@tipsynails.com" class="flex items-center">
            <img src={email.src} alt="email icon" class="h-8 pr-2" />
            hello@tipsynails.com
          </a>
          <a href="tel:3055550142" class="flex items-center">
            <img src={smartphone.src} alt="phone icon" class="h-8 pr-2" />
            (305) 555-0142
          </a>
          <div class="flex items-center">
            <img src={location.src} alt="location icon" class="h-8 pr-2" />
            <p>
              220 Miracle Mile, Suite 4, <br class="block md:hidden" />
              Coral Gables, FL 33134
            </p>
          </div>
        </div>
        <div class="flex flex-col gap-4 items-center pt-4">
          <h1 class="text-2xl text-pink-500">Hours</h1>
          <p class="t">TUE - SAT: 10:00 AM - 07:00 PM</p>
          <p>SUN: 11:00 AM - 04:00 PM</p>
          <a href="#contact">
            <button
              class="text-2xl border-2 font-bold hover:bg-pink-500 py-4 px-8 rounded-2xl hover:scale-105
            hover:text-white border-pink-500 text-pink-500 transition"
              >Book Now</button
            >
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
